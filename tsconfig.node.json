{
  "extends": "tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "lib": ["ESnext", "DOM", "WebWorker"],
    "outDir": "./dist/main",
    "types": ["node", "electron"]
  },
  "include": [
    "vite.config.ts",
    "server/MyApp/src/main/**/*",
    "server/devolper/electron/**/*.ts"
  ],
  "exclude": [
    "server/MyApp/src/renderer"
  ]
}
