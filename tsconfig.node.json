{
  "extends": "tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": false,
    "lib": ["ES2021", "DOM", "WebWorker"],
    "outDir": "./dist/main",
    "types": ["node", "electron"]
  },
  "include": [
    "vite.config.ts",
    "server/MyApp/src/main/**/*",
    "server/devolper/electron/**/*.ts"
  ],
  "exclude": [
    "server/MyApp/src/renderer"
  ]
}
