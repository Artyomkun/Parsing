{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ESnext",
    "module": "ESNext",
    "moduleResolution": "nodenext",
    "lib": ["ESnext"],
    "outDir": "./dist/preload",
    "rootDir": "./server/MyApp/src/preload",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "sourceMap": true,
    "types": ["nodenext", "electron"],
    "skipLibCheck": true
  },
  "include": [
    "server/MyApp/src/preload/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
