{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@main/*": ["./server/MyApp/src/main/*"],
      "@preload/*": ["./server/MyApp/src/preload/*"],
      "@renderer/*": ["./server/MyApp/src/renderer/*"],
      "@shared/*": ["./shared/*"],
      "@types/*": ["./src/types/*"],
      "@server/*": ["./server/*"]
    },
    "lib": ["ES2020", "DOM", "ESNext.AsyncIterable"],
    "types": ["node"]
  },
  "include": [
    "server/MyApp/src/main/**/*",
    "server/MyApp/src/preload/**/*",
    "server/MyApp/src/renderer/**/*",
    "shared/**/*",
    "src/types/**/*",
    "server/**/*.ts",
    "client/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
