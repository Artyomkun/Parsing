{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@src/*": ["./MyApp/src/*"],
      "@types/*": ["./server/types/*"],
      "@server/*": ["./server/*"],
    },
    "lib": ["ESNext", "DOM", "ESNext.AsyncIterable"],
    "types": ["node"]
  },
  "include": [
    "./MyApp/**/*",
    "./server/**/*.ts",
    "./server/types/**/*.d.ts",
    "./tests/**/*.ts",
  ],
  "exclude": ["node_modules", "dist"]
}
