{
  "name": "text-processor",
  "version": "1.8.1",
  "type": "text_processor",
  "description": "Многоуровневый обработчик текста с поддержкой 5D анализа",
  "author": "User",
  "created": "2025-01-11T16:30:15",
  "mainClass": "TextProcessor",
  "dependencies": [
    "kotlinx.coroutines",
    "kotlinx.serialization",
    "org.jsoup"
  ],
  "capabilities": [
    "text_preprocessing",
    "language_detection",
    "sentiment_analysis",
    "keyword_extraction",
    "text_summarization"
  ],
  "config": {
    "supported_languages": ["ru", "en", "de", "fr", "es"],
    "max_text_length": 100000,
    "enable_stemming": true,
    "custom_stopwords": true
  }
}
