    <!-- ===================================================== -->
    <!-- General Suppression Patterns - 2025                  -->
    <!-- ===================================================== -->
    
    <!-- Suppress low severity issues in development tools -->
    <suppress base="true">
        <notes><![CDATA[
        Suppress low and medium severity issues in development context
        ]]></notes>
        <severity>LOW</severity>
        <severity>MEDIUM</severity>
    </suppress>
    
    <!-- Suppress vulnerabilities that require specific network conditions -->
    <suppress base="true">
        <notes><![CDATA[
        Suppress network-based vulnerabilities in offline AI application
        ]]></notes>
        <vulnerabilityName regex="true">.*SSRF.*</vulnerabilityName>
        <vulnerabilityName regex="true">.*XXE.*</vulnerabilityName>
        <vulnerabilityName regex="true">.*Deserialization.*</vulnerabilityName>
    </suppress>

