{
  "name": "data-extractor",
  "version": "1.5.2",
  "type": "data_extractor",
  "description": "Экстрактор данных из различных источников с 5D контекстом",
  "author": "User",
  "created": "2025-01-11T16:31:00",
  "mainClass": "DataExtractor",
  "dependencies": [
    "kotlinx.coroutines",
    "kotlinx.serialization",
    "org.jsoup",
    "com.fasterxml.jackson"
  ],
  "capabilities": [
    "web_scraping",
    "api_data_extraction",
    "database_connectors",
    "file_parsing",
    "data_transformation"
  ],
  "config": {
    "max_concurrent_requests": 10,
    "request_timeout_sec": 30,
    "retry_attempts": 3,
    "output_format": "json",
    "enable_caching": true
  }
}
